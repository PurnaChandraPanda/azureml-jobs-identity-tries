$schema: https://azuremlschemas.azureedge.net/latest/commandJob.schema.json

type: command
display_name: identity-validation-serverless
experiment_name: identity-validation

code: src

command: >-
  python identity_probe.py
  --test-id ${{inputs.test_id}}
  --credential-mode ${{inputs.credential_mode}}
  --expect-token-failure ${{inputs.expect_token_failure}}
  --output-dir ${{outputs.identity_report}}

environment: azureml:idenv:1

# IMPORTANT:
# Do not add a compute property.
# Omitting compute makes this a serverless compute job.

identity:
  type: user_identity

inputs:
  test_id: T6
  credential_mode: obo

outputs:
  identity_report:
    type: uri_folder
    path: azureml://datastores/workspaceblobstore/paths/identity-validation/job-outputs/${{name}}/${{output_name}}
    mode: upload